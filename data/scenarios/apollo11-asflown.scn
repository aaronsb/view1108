TIMELINE T=000:01:23.00 KIND=LAUNCH NAME="Maximum dynamic pressure (735.17 lb/ft2)" SRC="SP p. 105"
TIMELINE T=000:01:31.50 KIND=LAUNCH NAME="Maximum bending moment (33,200,000 lbf-in)" SRC="SP p. 105"
TIMELINE T=000:02:15.20 KIND=STAGING NAME="S-IC center engine cutoff command" SRC="SP p. 105"
TIMELINE T=000:02:40.00 KIND=LAUNCH NAME="Pitch maneuver ended" SRC="SP p. 105"
TIMELINE T=000:02:41.63 KIND=STAGING NAME="S-IC outboard engine cutoff" SRC="SP p. 105"
TIMELINE T=000:02:41.71 KIND=STAGING NAME="S-IC maximum total inertial acceleration (3.94 g)" SRC="SP p. 105"
TIMELINE T=000:02:42.30 KIND=STAGING NAME="S-IC maximum Earth-fixed velocity. S-IC/S-II separation..." SRC="SP p. 105"
TIMELINE T=000:02:43.04 KIND=STAGING NAME="S-II engine start command" SRC="SP p. 105"
TIMELINE T=000:02:44.00 KIND=STAGING NAME="S-II ignition" SRC="SP p. 105"
