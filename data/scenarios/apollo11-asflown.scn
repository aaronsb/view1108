TIMELINE T=000:07:40.62 KIND=STAGING NAME="S-II center engine cutoff" SRC="SP p. 105"
TIMELINE T=000:07:40.70 KIND=STAGING NAME="S-II maximum total inertial acceleration (1.82 g)" SRC="SP p. 105"
